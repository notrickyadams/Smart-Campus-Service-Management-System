<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="850" prefWidth="800" style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.app.controllers.AdminDashboardController">

    <!-- TOP NAVBAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="             -fx-background-color: rgba(15,23,42,0.95);             -fx-padding: 15 35 15 35;             -fx-border-color: #334155;             -fx-border-width: 0 0 1 0;">

            <VBox spacing="2">
                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: bold;" text="UNIVERSITY SERVICE SYSTEM" />
                <Label style="-fx-text-fill: white; -fx-font-size: 26; -fx-font-weight: bold;" text="Admin Dashboard" />
            </VBox>

            <Pane HBox.hgrow="ALWAYS" />

            <Button fx:id="themeButton" prefHeight="38" prefWidth="150" style="                 -fx-background-color: #1e293b;                 -fx-text-fill: white;                 -fx-font-size: 13;                 -fx-font-weight: bold;                 -fx-background-radius: 14;                 -fx-border-color: #475569;                 -fx-border-radius: 14;                 -fx-cursor: hand;" text="☾ Dark Mode" />
        </HBox>
    </top>

    <!-- SCROLLABLE MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="                 -fx-background: transparent;                 -fx-background-color: transparent;                 -fx-padding: 0;" vbarPolicy="AS_NEEDED">

            <HBox alignment="TOP_CENTER" spacing="25" style="-fx-padding: 25;">

                <!-- LEFT CONTENT -->
                <VBox spacing="20" HBox.hgrow="ALWAYS">

                    <!-- SECTION HEADER -->
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" text="Request Management" />
                            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13;" text="Manage student service requests efficiently" />
                        </VBox>

                        <Pane HBox.hgrow="ALWAYS" />

                        <Button fx:id="refreshButton" onAction="#refreshUI" prefHeight="38" prefWidth="130" style="                             -fx-background-color: #2563eb;                             -fx-text-fill: white;                             -fx-font-size: 13;                             -fx-font-weight: bold;                             -fx-background-radius: 14;                             -fx-cursor: hand;" text="⟳ Refresh" />
                    </HBox>

                    <!-- REQUEST TABLE CARD -->
                    <StackPane style="                         -fx-background-color: rgba(255,255,255,0.05);                         -fx-background-radius: 20;                         -fx-padding: 20;                         -fx-border-color: rgba(255,255,255,0.08);                         -fx-border-radius: 20;">

                        <TableView fx:id="requestTable" prefHeight="811.0" prefWidth="369.0" style="                             -fx-background-color: transparent;                             -fx-control-inner-background: #1e293b;                             -fx-table-cell-border-color: transparent;                             -fx-font-size: 13;                             -fx-text-fill: white;">
                            <columns>
                                <TableColumn fx:id="studentColumn" prefWidth="180" text="Student" />
                                <TableColumn fx:id="serviceColumn" prefWidth="280" text="Requested Service" />
                                <TableColumn fx:id="statusColumn" prefWidth="150" text="Status" />
                            </columns>
                        </TableView>
                    </StackPane>

                </VBox>

                <!-- RIGHT SIDEBAR -->
                <VBox prefWidth="300" spacing="20">

                    <!-- ADMIN PROFILE CARD -->
                    <VBox alignment="CENTER" spacing="12" style="                         -fx-background-color: rgba(255,255,255,0.05);                         -fx-background-radius: 20;                         -fx-padding: 25;                         -fx-border-color: rgba(255,255,255,0.08);                         -fx-border-radius: 20;">
                        <Label style="-fx-font-size: 42;" text="👨‍💼" />
                        <Label style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" text="Administrator" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="System Control Panel" />
                    </VBox>

                    <!-- QUICK ACTIONS CARD -->
                    <VBox spacing="14" style="                         -fx-background-color: rgba(255,255,255,0.05);                         -fx-background-radius: 20;                         -fx-padding: 20;                         -fx-border-color: rgba(255,255,255,0.08);                         -fx-border-radius: 20;">
                        <Label style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" text="Quick Actions" />

                        <Button fx:id="approveButton" onAction="#handleApprove" prefHeight="46" prefWidth="260" style="                             -fx-background-color: #22c55e;                             -fx-text-fill: white;                             -fx-font-size: 14;                             -fx-font-weight: bold;                             -fx-background-radius: 14;                             -fx-cursor: hand;" text="✔ Approve Request" />

                        <Button fx:id="rejectButton" onAction="#handleReject" prefHeight="46" prefWidth="260" style="                             -fx-background-color: #ef4444;                             -fx-text-fill: white;                             -fx-font-size: 14;                             -fx-font-weight: bold;                             -fx-background-radius: 14;                             -fx-cursor: hand;" text="✖ Reject Request" />
                    </VBox>

                    <!-- SYSTEM ANALYTICS CARD -->
                    <VBox spacing="14" style="                         -fx-background-color: rgba(255,255,255,0.05);                         -fx-background-radius: 20;                         -fx-padding: 20;                         -fx-border-color: rgba(255,255,255,0.08);                         -fx-border-radius: 20;">
                        <Label style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" text="System Analytics" />

                        <!-- TOTAL -->
                        <HBox alignment="CENTER_LEFT" spacing="14" style="                             -fx-background-color: rgba(59,130,246,0.15);                             -fx-background-radius: 14;                             -fx-padding: 12;">
                            <Label style="-fx-font-size: 20;" text="📄" />
                            <VBox>
                                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" text="Total Requests" />
                                <Label fx:id="totalRequestsLabel" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" text="0" />
                            </VBox>
                        </HBox>

                        <!-- PENDING -->
                        <HBox alignment="CENTER_LEFT" spacing="14" style="                             -fx-background-color: rgba(245,158,11,0.15);                             -fx-background-radius: 14;                             -fx-padding: 12;">
                            <Label style="-fx-font-size: 20;" text="⏳" />
                            <VBox>
                                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" text="Pending" />
                                <Label fx:id="pendingRequestsLabel" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" text="0" />
                            </VBox>
                        </HBox>

                        <!-- APPROVED -->
                        <HBox alignment="CENTER_LEFT" spacing="14" style="                             -fx-background-color: rgba(34,197,94,0.15);                             -fx-background-radius: 14;                             -fx-padding: 12;">
                            <Label style="-fx-font-size: 20;" text="✔" />
                            <VBox>
                                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" text="Approved" />
                                <Label fx:id="approvedRequestsLabel" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" text="0" />
                            </VBox>
                        </HBox>

                        <!-- REJECTED -->
                        <HBox alignment="CENTER_LEFT" spacing="14" style="                             -fx-background-color: rgba(239,68,68,0.15);                             -fx-background-radius: 14;                             -fx-padding: 12;">
                            <Label style="-fx-font-size: 20;" text="✖" />
                            <VBox>
                                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" text="Rejected" />
                                <Label fx:id="rejectedRequestsLabel" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" text="0" />
                            </VBox>
                        </HBox>

                        <Button prefHeight="46" prefWidth="260"
                                onAction="#goToAnalytics"
                                style="
        -fx-background-color: #7c3aed;
        -fx-text-fill: white;
        -fx-font-size: 14;
        -fx-font-weight: bold;
        -fx-background-radius: 14;
        -fx-cursor: hand;"
                                text="📊 View Analytics" />

                    </VBox>


                </VBox>

            </HBox>
        </ScrollPane>
    </center>

</BorderPane>
