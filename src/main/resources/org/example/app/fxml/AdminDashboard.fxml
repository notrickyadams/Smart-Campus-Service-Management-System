<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="500" prefWidth="700" style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.app.controllers.AdminDashboardController">


    <!-- ========================= TOP NAVBAR ========================= -->

    <top>

        <HBox alignment="CENTER_LEFT" spacing="20" style="               -fx-background-color: rgba(15,23,42,0.95);               -fx-padding: 20 35 20 35;               -fx-border-color: #334155;               -fx-border-width: 0 0 1 0;               ">

            <!-- LOGO / TITLE -->

            <VBox spacing="2">

                <Label style="                        -fx-text-fill: #94a3b8;                        -fx-font-size: 13;                        -fx-font-weight: bold;                        -fx-letter-spacing: 1;                        " text="UNIVERSITY SERVICE SYSTEM" />

                <Label style="                        -fx-text-fill: white;                        -fx-font-size: 34;                        -fx-font-weight: bold;                        " text="Admin Dashboard" />

            </VBox>

            <Pane HBox.hgrow="ALWAYS" />

            <!-- DARK MODE BUTTON -->

            <Button fx:id="themeButton" prefHeight="42" prefWidth="160" style="                     -fx-background-color: #1e293b;                     -fx-text-fill: white;                     -fx-font-size: 14;                     -fx-font-weight: bold;                     -fx-background-radius: 14;                     -fx-border-color: #475569;                     -fx-border-radius: 14;                     -fx-cursor: hand;                     " text="☾ Dark Mode" />

        </HBox>

    </top>

    <!-- ========================= MAIN CONTENT ========================= -->

    <center>

        <HBox alignment="CENTER" spacing="30" style="-fx-padding: 30;">

            <!-- ================= LEFT CONTENT ================= -->

            <VBox spacing="25" HBox.hgrow="ALWAYS">

                <!-- SECTION HEADER -->

                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="5">

                        <Label style="                                -fx-text-fill: white;                                -fx-font-size: 28;                                -fx-font-weight: bold;                                " text="Request Management" />

                        <Label style="                                -fx-text-fill: #94a3b8;                                -fx-font-size: 14;                                " text="Manage student service requests efficiently" />

                    </VBox>

                    <Pane HBox.hgrow="ALWAYS" />

                    <!-- REFRESH BUTTON -->

                    <Button fx:id="refreshButton" prefHeight="42" prefWidth="140" style="                             -fx-background-color: #2563eb;                             -fx-text-fill: white;                             -fx-font-size: 14;                             -fx-font-weight: bold;                             -fx-background-radius: 14;                             -fx-cursor: hand;                             " text="⟳ Refresh"
                            onAction="#refreshUI"/>

                </HBox>

                <!-- REQUEST TABLE CARD -->

                <StackPane prefHeight="846.0" prefWidth="360.0" style="                            -fx-background-color: rgba(255,255,255,0.05);                            -fx-background-radius: 24;                            -fx-padding: 25;                            -fx-border-color: rgba(255,255,255,0.08);                            -fx-border-radius: 24;                            ">

                    <TableView fx:id="requestTable" prefHeight="752.0" prefWidth="431.0" style="                                -fx-background-color: transparent;                                -fx-control-inner-background: #1e293b;                                -fx-table-cell-border-color: transparent;                                -fx-font-size: 14;                                -fx-text-fill: white;                                ">

                        <columns>

                            <TableColumn fx:id="studentColumn" prefWidth="220" text="Student" />

                            <TableColumn fx:id="serviceColumn" prefWidth="340" text="Requested Service" />

                            <TableColumn fx:id="statusColumn" prefWidth="180" text="Status" />

                        </columns>

                    </TableView>

                </StackPane>

            </VBox>

            <!-- ================= RIGHT SIDEBAR ================= -->

            <VBox prefWidth="320" spacing="25">

                <!-- ADMIN PROFILE CARD -->

                <VBox alignment="CENTER" spacing="15" style="                       -fx-background-color: rgba(255,255,255,0.05);                       -fx-background-radius: 24;                       -fx-padding: 30;                       -fx-border-color: rgba(255,255,255,0.08);                       -fx-border-radius: 24;                       ">

                    <Label style="-fx-font-size: 48;" text="👨‍💼" />

                    <Label style="                            -fx-text-fill: white;                            -fx-font-size: 20;                            -fx-font-weight: bold;                            " text="Administrator" />

                    <Label style="                            -fx-text-fill: #94a3b8;                            -fx-font-size: 13;                            " text="System Control Panel" />

                </VBox>

                <!-- ACTIONS CARD -->

                <VBox spacing="18" style="                       -fx-background-color: rgba(255,255,255,0.05);                       -fx-background-radius: 24;                       -fx-padding: 25;                       -fx-border-color: rgba(255,255,255,0.08);                       -fx-border-radius: 24;                       ">

                    <Label style="                            -fx-text-fill: white;                            -fx-font-size: 20;                            -fx-font-weight: bold;                            " text="Quick Actions" />

                    <!-- APPROVE -->

                    <Button fx:id="approveButton" prefHeight="50" prefWidth="260" style="                             -fx-background-color: #22c55e;                             -fx-text-fill: white;                             -fx-font-size: 15;                             -fx-font-weight: bold;                             -fx-background-radius: 16;                             -fx-cursor: hand;                             " text="✔ Approve Request"
                            onAction="#handleApprove"/>


                    <!-- REJECT -->

                    <Button fx:id="rejectButton" prefHeight="50" prefWidth="260" style="                             -fx-background-color: #ef4444;                             -fx-text-fill: white;                             -fx-font-size: 15;                             -fx-font-weight: bold;                             -fx-background-radius: 16;                             -fx-cursor: hand;                             " text="✖ Reject Request"
                            onAction="#handleReject"/>


                </VBox>

                <!-- LIVE STATISTICS -->

                <VBox spacing="18" style="                       -fx-background-color: rgba(255,255,255,0.05);                       -fx-background-radius: 24;                       -fx-padding: 25;                       -fx-border-color: rgba(255,255,255,0.08);                       -fx-border-radius: 24;                       ">

                    <Label style="                            -fx-text-fill: white;                            -fx-font-size: 20;                            -fx-font-weight: bold;                            " text="System Analytics" />

                    <!-- TOTAL -->

                    <HBox alignment="CENTER_LEFT" spacing="15" style="                           -fx-background-color: rgba(59,130,246,0.15);                           -fx-background-radius: 16;                           -fx-padding: 15;                           ">

                        <Label style="-fx-font-size: 22;" text="📄" />

                        <VBox>

                            <Label style="                                    -fx-text-fill: #94a3b8;                                    -fx-font-size: 12;                                    " text="Total Requests" />

                            <Label fx:id="totalRequestsLabel" style="                                    -fx-text-fill: white;                                    -fx-font-size: 24;                                    -fx-font-weight: bold;                                    " text="0" />

                        </VBox>

                    </HBox>

                    <!-- PENDING -->

                    <HBox alignment="CENTER_LEFT" spacing="15" style="                           -fx-background-color: rgba(245,158,11,0.15);                           -fx-background-radius: 16;                           -fx-padding: 15;                           ">

                        <Label style="-fx-font-size: 22;" text="⏳" />

                        <VBox>

                            <Label style="                                    -fx-text-fill: #94a3b8;                                    -fx-font-size: 12;                                    " text="Pending" />

                            <Label fx:id="pendingRequestsLabel" style="                                    -fx-text-fill: white;                                    -fx-font-size: 24;                                    -fx-font-weight: bold;                                    " text="0" />

                        </VBox>

                    </HBox>

                    <!-- APPROVED -->

                    <HBox alignment="CENTER_LEFT" spacing="15" style="                           -fx-background-color: rgba(34,197,94,0.15);                           -fx-background-radius: 16;                           -fx-padding: 15;                           ">

                        <Label style="-fx-font-size: 22;" text="✔" />

                        <VBox>

                            <Label style="                                    -fx-text-fill: #94a3b8;                                    -fx-font-size: 12;                                    " text="Approved" />

                            <Label fx:id="approvedRequestsLabel" style="                                    -fx-text-fill: white;                                    -fx-font-size: 24;                                    -fx-font-weight: bold;                                    " text="0" />

                        </VBox>

                    </HBox>

                    <!-- REJECTED -->

                    <HBox alignment="CENTER_LEFT" spacing="15" style="                           -fx-background-color: rgba(239,68,68,0.15);                           -fx-background-radius: 16;                           -fx-padding: 15;                           ">

                        <Label style="-fx-font-size: 22;" text="✖" />

                        <VBox>

                            <Label style="                                    -fx-text-fill: #94a3b8;                                    -fx-font-size: 12;                                    " text="Rejected" />

                            <Label fx:id="rejectedRequestsLabel" style="                                    -fx-text-fill: white;                                    -fx-font-size: 24;                                    -fx-font-weight: bold;                                    " text="0" />

                        </VBox>

                    </HBox>

                </VBox>

            </VBox>

        </HBox>

    </center>

</BorderPane>
