<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.app.controllers.AdminDashboardController"
            prefWidth="1400"
            prefHeight="850"
            style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);">

    <!-- ========================= TOP NAVBAR ========================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="20"
              style="
              -fx-background-color: rgba(15,23,42,0.95);
              -fx-padding: 20 35 20 35;
              -fx-border-color: #334155;
              -fx-border-width: 0 0 1 0;
              ">

            <!-- LOGO / TITLE -->

            <VBox spacing="2">

                <Label text="UNIVERSITY SERVICE SYSTEM"
                       style="
                       -fx-text-fill: #94a3b8;
                       -fx-font-size: 13;
                       -fx-font-weight: bold;
                       -fx-letter-spacing: 1;
                       "/>

                <Label text="Admin Dashboard"
                       style="
                       -fx-text-fill: white;
                       -fx-font-size: 34;
                       -fx-font-weight: bold;
                       "/>

            </VBox>

            <Pane HBox.hgrow="ALWAYS"/>

            <!-- DARK MODE BUTTON -->

            <Button fx:id="themeButton"
                    text="☾ Dark Mode"
                    prefWidth="160"
                    prefHeight="42"
                    style="
                    -fx-background-color: #1e293b;
                    -fx-text-fill: white;
                    -fx-font-size: 14;
                    -fx-font-weight: bold;
                    -fx-background-radius: 14;
                    -fx-border-color: #475569;
                    -fx-border-radius: 14;
                    -fx-cursor: hand;
                    "/>

        </HBox>

    </top>

    <!-- ========================= MAIN CONTENT ========================= -->

    <center>

        <HBox spacing="30"
              style="-fx-padding: 30;">

            <!-- ================= LEFT CONTENT ================= -->

            <VBox spacing="25"
                  HBox.hgrow="ALWAYS">

                <!-- SECTION HEADER -->

                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="5">

                        <Label text="Request Management"
                               style="
                               -fx-text-fill: white;
                               -fx-font-size: 28;
                               -fx-font-weight: bold;
                               "/>

                        <Label text="Manage student service requests efficiently"
                               style="
                               -fx-text-fill: #94a3b8;
                               -fx-font-size: 14;
                               "/>

                    </VBox>

                    <Pane HBox.hgrow="ALWAYS"/>

                    <!-- REFRESH BUTTON -->

                    <Button fx:id="refreshButton"
                            text="⟳ Refresh"
                            prefWidth="140"
                            prefHeight="42"
                            style="
                            -fx-background-color: #2563eb;
                            -fx-text-fill: white;
                            -fx-font-size: 14;
                            -fx-font-weight: bold;
                            -fx-background-radius: 14;
                            -fx-cursor: hand;
                            "/>

                </HBox>

                <!-- REQUEST TABLE CARD -->

                <StackPane style="
                           -fx-background-color: rgba(255,255,255,0.05);
                           -fx-background-radius: 24;
                           -fx-padding: 25;
                           -fx-border-color: rgba(255,255,255,0.08);
                           -fx-border-radius: 24;
                           ">

                    <TableView fx:id="requestTable"
                               prefHeight="580"
                               style="
                               -fx-background-color: transparent;
                               -fx-control-inner-background: #1e293b;
                               -fx-table-cell-border-color: transparent;
                               -fx-font-size: 14;
                               -fx-text-fill: white;
                               ">

                        <columns>

                            <TableColumn fx:id="studentColumn"
                                         text="Student"
                                         prefWidth="220"/>

                            <TableColumn fx:id="serviceColumn"
                                         text="Requested Service"
                                         prefWidth="340"/>

                            <TableColumn fx:id="statusColumn"
                                         text="Status"
                                         prefWidth="180"/>

                        </columns>

                    </TableView>

                </StackPane>

            </VBox>

            <!-- ================= RIGHT SIDEBAR ================= -->

            <VBox spacing="25"
                  prefWidth="320">

                <!-- ADMIN PROFILE CARD -->

                <VBox spacing="15"
                      alignment="CENTER"
                      style="
                      -fx-background-color: rgba(255,255,255,0.05);
                      -fx-background-radius: 24;
                      -fx-padding: 30;
                      -fx-border-color: rgba(255,255,255,0.08);
                      -fx-border-radius: 24;
                      ">

                    <Label text="👨‍💼"
                           style="-fx-font-size: 48;"/>

                    <Label text="Administrator"
                           style="
                           -fx-text-fill: white;
                           -fx-font-size: 20;
                           -fx-font-weight: bold;
                           "/>

                    <Label text="System Control Panel"
                           style="
                           -fx-text-fill: #94a3b8;
                           -fx-font-size: 13;
                           "/>

                </VBox>

                <!-- ACTIONS CARD -->

                <VBox spacing="18"
                      style="
                      -fx-background-color: rgba(255,255,255,0.05);
                      -fx-background-radius: 24;
                      -fx-padding: 25;
                      -fx-border-color: rgba(255,255,255,0.08);
                      -fx-border-radius: 24;
                      ">

                    <Label text="Quick Actions"
                           style="
                           -fx-text-fill: white;
                           -fx-font-size: 20;
                           -fx-font-weight: bold;
                           "/>

                    <!-- APPROVE -->

                    <Button fx:id="approveButton"
                            text="✔ Approve Request"
                            prefWidth="260"
                            prefHeight="50"
                            style="
                            -fx-background-color: #22c55e;
                            -fx-text-fill: white;
                            -fx-font-size: 15;
                            -fx-font-weight: bold;
                            -fx-background-radius: 16;
                            -fx-cursor: hand;
                            "/>

                    <!-- REJECT -->

                    <Button fx:id="rejectButton"
                            text="✖ Reject Request"
                            prefWidth="260"
                            prefHeight="50"
                            style="
                            -fx-background-color: #ef4444;
                            -fx-text-fill: white;
                            -fx-font-size: 15;
                            -fx-font-weight: bold;
                            -fx-background-radius: 16;
                            -fx-cursor: hand;
                            "/>

                </VBox>

                <!-- LIVE STATISTICS -->

                <VBox spacing="18"
                      style="
                      -fx-background-color: rgba(255,255,255,0.05);
                      -fx-background-radius: 24;
                      -fx-padding: 25;
                      -fx-border-color: rgba(255,255,255,0.08);
                      -fx-border-radius: 24;
                      ">

                    <Label text="System Analytics"
                           style="
                           -fx-text-fill: white;
                           -fx-font-size: 20;
                           -fx-font-weight: bold;
                           "/>

                    <!-- TOTAL -->

                    <HBox alignment="CENTER_LEFT"
                          spacing="15"
                          style="
                          -fx-background-color: rgba(59,130,246,0.15);
                          -fx-background-radius: 16;
                          -fx-padding: 15;
                          ">

                        <Label text="📄"
                               style="-fx-font-size: 22;"/>

                        <VBox>

                            <Label text="Total Requests"
                                   style="
                                   -fx-text-fill: #94a3b8;
                                   -fx-font-size: 12;
                                   "/>

                            <Label fx:id="totalRequestsLabel"
                                   text="0"
                                   style="
                                   -fx-text-fill: white;
                                   -fx-font-size: 24;
                                   -fx-font-weight: bold;
                                   "/>

                        </VBox>

                    </HBox>

                    <!-- PENDING -->

                    <HBox alignment="CENTER_LEFT"
                          spacing="15"
                          style="
                          -fx-background-color: rgba(245,158,11,0.15);
                          -fx-background-radius: 16;
                          -fx-padding: 15;
                          ">

                        <Label text="⏳"
                               style="-fx-font-size: 22;"/>

                        <VBox>

                            <Label text="Pending"
                                   style="
                                   -fx-text-fill: #94a3b8;
                                   -fx-font-size: 12;
                                   "/>

                            <Label fx:id="pendingRequestsLabel"
                                   text="0"
                                   style="
                                   -fx-text-fill: white;
                                   -fx-font-size: 24;
                                   -fx-font-weight: bold;
                                   "/>

                        </VBox>

                    </HBox>

                    <!-- APPROVED -->

                    <HBox alignment="CENTER_LEFT"
                          spacing="15"
                          style="
                          -fx-background-color: rgba(34,197,94,0.15);
                          -fx-background-radius: 16;
                          -fx-padding: 15;
                          ">

                        <Label text="✔"
                               style="-fx-font-size: 22;"/>

                        <VBox>

                            <Label text="Approved"
                                   style="
                                   -fx-text-fill: #94a3b8;
                                   -fx-font-size: 12;
                                   "/>

                            <Label fx:id="approvedRequestsLabel"
                                   text="0"
                                   style="
                                   -fx-text-fill: white;
                                   -fx-font-size: 24;
                                   -fx-font-weight: bold;
                                   "/>

                        </VBox>

                    </HBox>

                    <!-- REJECTED -->

                    <HBox alignment="CENTER_LEFT"
                          spacing="15"
                          style="
                          -fx-background-color: rgba(239,68,68,0.15);
                          -fx-background-radius: 16;
                          -fx-padding: 15;
                          ">

                        <Label text="✖"
                               style="-fx-font-size: 22;"/>

                        <VBox>

                            <Label text="Rejected"
                                   style="
                                   -fx-text-fill: #94a3b8;
                                   -fx-font-size: 12;
                                   "/>

                            <Label fx:id="rejectedRequestsLabel"
                                   text="0"
                                   style="
                                   -fx-text-fill: white;
                                   -fx-font-size: 24;
                                   -fx-font-weight: bold;
                                   "/>

                        </VBox>

                    </HBox>

                </VBox>

            </VBox>

        </HBox>

    </center>

</BorderPane>