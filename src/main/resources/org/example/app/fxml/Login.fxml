<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        prefHeight="850" prefWidth="800"
        fx:id="rootPane"
        style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);"
        xmlns="http://javafx.com/javafx/17.0.2-ea"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.app.controllers.LoginController">

    <!-- TOP NAVBAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="
            -fx-background-color: rgba(15,23,42,0.95);
            -fx-padding: 15 35 15 35;
            -fx-border-color: #334155;
            -fx-border-width: 0 0 1 0;">

            <VBox spacing="2">
                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: bold;"
                       text="UNIVERSITY SERVICE SYSTEM" />
                <Label style="-fx-text-fill: white; -fx-font-size: 26; -fx-font-weight: bold;"
                       text="Welcome Back" />
            </VBox>

            <Pane HBox.hgrow="ALWAYS" />

            <Button fx:id="themeButton" prefHeight="38" prefWidth="150"
                    onAction="#toggleTheme"
                    style="
                    -fx-background-color: #1e293b;
                    -fx-text-fill: white;
                    -fx-font-size: 13;
                    -fx-font-weight: bold;
                    -fx-background-radius: 14;
                    -fx-border-color: #475569;
                    -fx-border-radius: 14;
                    -fx-cursor: hand;"
                    text="☾ Dark Mode" />
        </HBox>
    </top>

    <!-- CENTER LOGIN CARD -->
    <center>
        <StackPane>
            <VBox fx:id="loginCard" alignment="CENTER" spacing="20" maxWidth="420" style="
                -fx-background-color: rgba(255,255,255,0.05);
                -fx-background-radius: 24;
                -fx-padding: 45;
                -fx-border-color: rgba(255,255,255,0.08);
                -fx-border-radius: 24;">

                <!-- ICON — changes based on role -->
                <Label fx:id="roleIcon" style="-fx-font-size: 52;" text="🎓" />

                <!-- ROLE TOGGLE -->
                <VBox alignment="CENTER" spacing="10">
                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12; -fx-font-weight: bold;"
                           text="SELECT YOUR ROLE" />
                    <HBox spacing="0" alignment="CENTER">

                        <!-- STUDENT BUTTON -->
                        <Button fx:id="studentRoleBtn"
                                text="🎓  Student"
                                prefHeight="42" prefWidth="160"
                                onAction="#selectStudent"
                                style="
                                -fx-background-color: #2563eb;
                                -fx-text-fill: white;
                                -fx-font-size: 13;
                                -fx-font-weight: bold;
                                -fx-background-radius: 14 0 0 14;
                                -fx-cursor: hand;" />

                        <!-- ADMIN BUTTON -->
                        <Button fx:id="adminRoleBtn"
                                text="👨‍💼  Admin"
                                prefHeight="42" prefWidth="160"
                                onAction="#selectAdmin"
                                style="
                                -fx-background-color: rgba(255,255,255,0.07);
                                -fx-text-fill: #94a3b8;
                                -fx-font-size: 13;
                                -fx-font-weight: bold;
                                -fx-background-radius: 0 14 14 0;
                                -fx-border-color: #334155;
                                -fx-border-radius: 0 14 14 0;
                                -fx-cursor: hand;" />
                    </HBox>
                </VBox>

                <!-- TITLE -->
                <VBox alignment="CENTER" spacing="6">
                    <Label fx:id="roleTitle" style="
                        -fx-text-fill: white;
                        -fx-font-size: 26;
                        -fx-font-weight: bold;"
                           text="Student Sign In" />
                    <Label fx:id="roleSubtitle" style="
                        -fx-text-fill: #94a3b8;
                        -fx-font-size: 13;"
                           text="Enter your student credentials" />
                </VBox>

                <!-- USERNAME -->
                <VBox spacing="7" maxWidth="340">
                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12; -fx-font-weight: bold;"
                           text="USERNAME" />
                    <TextField fx:id="usernameField" promptText="Enter your username"
                               prefHeight="46" prefWidth="340"
                               style="
                            -fx-background-color: rgba(255,255,255,0.07);
                            -fx-text-fill: white;
                            -fx-prompt-text-fill: #475569;
                            -fx-font-size: 14;
                            -fx-background-radius: 14;
                            -fx-border-color: #334155;
                            -fx-border-radius: 14;
                            -fx-padding: 0 15 0 15;" />
                </VBox>

                <!-- PASSWORD -->
                <VBox spacing="7" maxWidth="340">
                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12; -fx-font-weight: bold;"
                           text="PASSWORD" />
                    <PasswordField fx:id="passwordField" promptText="Enter your password"
                                   prefHeight="46" prefWidth="340"
                                   style="
                            -fx-background-color: rgba(255,255,255,0.07);
                            -fx-text-fill: white;
                            -fx-prompt-text-fill: #475569;
                            -fx-font-size: 14;
                            -fx-background-radius: 14;
                            -fx-border-color: #334155;
                            -fx-border-radius: 14;
                            -fx-padding: 0 15 0 15;" />
                </VBox>

                <!-- ERROR / SUCCESS MESSAGE -->
                <Label fx:id="messageLabel" prefWidth="340" wrapText="true" style="
                    -fx-text-fill: #ef4444;
                    -fx-font-size: 13;
                    -fx-font-weight: bold;
                    -fx-alignment: CENTER;" />

                <!-- LOGIN BUTTON -->
                <Button fx:id="loginButton" text="Sign In as Student →" prefHeight="50" prefWidth="340"
                        onAction="#handleLogin"
                        style="
                        -fx-background-color: #2563eb;
                        -fx-text-fill: white;
                        -fx-font-size: 15;
                        -fx-font-weight: bold;
                        -fx-background-radius: 14;
                        -fx-cursor: hand;" />

                <!-- FOOTER NOTE -->
                <Label style="-fx-text-fill: #475569; -fx-font-size: 12;"
                       text="Contact admin if you forgot your credentials" />

            </VBox>
        </StackPane>
    </center>

</BorderPane>