<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<BorderPane
        prefHeight="850" prefWidth="900"
        fx:id="rootPane"
        style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);"
        xmlns="http://javafx.com/javafx/17.0.2-ea"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.app.controllers.StudentAnalyticsController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="
            -fx-background-color: rgba(15,23,42,0.95);
            -fx-padding: 15 35 15 35;
            -fx-border-color: #334155;
            -fx-border-width: 0 0 1 0;">

            <Button onAction="#goBack" style="
                -fx-background-color: rgba(255,255,255,0.07);
                -fx-text-fill: white; -fx-font-size: 13;
                -fx-font-weight: bold; -fx-background-radius: 10;
                -fx-border-color: #334155; -fx-border-radius: 10;
                -fx-cursor: hand;"
                    text="← Back" prefHeight="36" prefWidth="90"/>

            <VBox spacing="2">
                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: bold;"
                       text="UNIVERSITY SERVICE SYSTEM" />
                <Label style="-fx-text-fill: white; -fx-font-size: 26; -fx-font-weight: bold;"
                       text="My Analytics" />
            </VBox>

            <Pane HBox.hgrow="ALWAYS" />

            <Button fx:id="themeButton" prefHeight="38" prefWidth="150"
                    onAction="#toggleTheme"
                    style="
                    -fx-background-color: #1e293b; -fx-text-fill: white;
                    -fx-font-size: 13; -fx-font-weight: bold;
                    -fx-background-radius: 14; -fx-border-color: #475569;
                    -fx-border-radius: 14; -fx-cursor: hand;"
                    text="☾ Dark Mode" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background: transparent; -fx-background-color: transparent;">

            <VBox spacing="20" style="-fx-padding: 25;">

                <!-- HEADER -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4">
                        <Label style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"
                               text="My Request Analytics" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13;"
                               text="Overview of your personal service requests" />
                    </VBox>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button prefHeight="38" prefWidth="120"
                            onAction="#refreshAnalytics"
                            style="
                            -fx-background-color: #2563eb; -fx-text-fill: white;
                            -fx-font-size: 13; -fx-font-weight: bold;
                            -fx-background-radius: 14; -fx-cursor: hand;"
                            text="⟳ Refresh" />
                </HBox>

                <!-- STAT CARDS -->
                <HBox spacing="15">
                    <HBox alignment="CENTER_LEFT" spacing="14"
                          HBox.hgrow="ALWAYS" style="
                        -fx-background-color: rgba(59,130,246,0.15);
                        -fx-background-radius: 16; -fx-padding: 16;">
                        <Label style="-fx-font-size: 22;" text="📄" />
                        <VBox>
                            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" text="Total" />
                            <Label fx:id="totalLabel" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" text="0" />
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="14"
                          HBox.hgrow="ALWAYS" style="
                        -fx-background-color: rgba(245,158,11,0.15);
                        -fx-background-radius: 16; -fx-padding: 16;">
                        <Label style="-fx-font-size: 22;" text="⏳" />
                        <VBox>
                            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" text="Pending" />
                            <Label fx:id="pendingLabel" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" text="0" />
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="14"
                          HBox.hgrow="ALWAYS" style="
                        -fx-background-color: rgba(34,197,94,0.15);
                        -fx-background-radius: 16; -fx-padding: 16;">
                        <Label style="-fx-font-size: 20;" text="✔" />
                        <VBox>
                            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" text="Approved" />
                            <Label fx:id="approvedLabel" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" text="0" />
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="14"
                          HBox.hgrow="ALWAYS" style="
                        -fx-background-color: rgba(239,68,68,0.15);
                        -fx-background-radius: 16; -fx-padding: 16;">
                        <Label style="-fx-font-size: 20;" text="✖" />
                        <VBox>
                            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" text="Rejected" />
                            <Label fx:id="rejectedLabel" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" text="0" />
                        </VBox>
                    </HBox>
                </HBox>

                <!-- CHARTS -->
                <HBox spacing="20">

                    <!-- PIE CHART -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS" style="
                        -fx-background-color: rgba(255,255,255,0.05);
                        -fx-background-radius: 20; -fx-padding: 20;
                        -fx-border-color: rgba(255,255,255,0.08);
                        -fx-border-radius: 20;">
                        <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"
                               text="My Request Status" />
                        <PieChart fx:id="statusPieChart" prefHeight="280"
                                  style="-fx-background-color: transparent;" />
                    </VBox>

                    <!-- BAR CHART -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS" style="
                        -fx-background-color: rgba(255,255,255,0.05);
                        -fx-background-radius: 20; -fx-padding: 20;
                        -fx-border-color: rgba(255,255,255,0.08);
                        -fx-border-radius: 20;">
                        <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"
                               text="Services I Requested" />
                        <BarChart fx:id="serviceBarChart" prefHeight="280"
                                  style="-fx-background-color: transparent;">
                            <xAxis><CategoryAxis /></xAxis>
                            <yAxis><NumberAxis /></yAxis>
                        </BarChart>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>