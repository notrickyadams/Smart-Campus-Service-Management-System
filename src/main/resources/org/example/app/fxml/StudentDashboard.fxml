<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        prefHeight="850" prefWidth="900"
        style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);"
        xmlns="http://javafx.com/javafx/17.0.2-ea"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.app.controllers.StudentDashboardController">

    <!-- TOP NAVBAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="
            -fx-background-color: rgba(15,23,42,0.95);
            -fx-padding: 15 35 15 35;
            -fx-border-color: #334155;
            -fx-border-width: 0 0 1 0;">

            <VBox spacing="2">
                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: bold;"
                       text="UNIVERSITY SERVICE SYSTEM" />
                <Label style="-fx-text-fill: white; -fx-font-size: 26; -fx-font-weight: bold;"
                       text="Student Dashboard" />
            </VBox>

            <Pane HBox.hgrow="ALWAYS" />

            <Button fx:id="themeButton" prefHeight="38" prefWidth="150"
                    onAction="#toggleTheme"
                    style="
                    -fx-background-color: #1e293b;
                    -fx-text-fill: white;
                    -fx-font-size: 13;
                    -fx-font-weight: bold;
                    -fx-background-radius: 14;
                    -fx-border-color: #475569;
                    -fx-border-radius: 14;
                    -fx-cursor: hand;"
                    text="☾ Dark Mode" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background: transparent; -fx-background-color: transparent;">

            <HBox alignment="TOP_CENTER" spacing="25" style="-fx-padding: 25;">

                <!-- LEFT: SERVICES GRID -->
                <VBox spacing="20" HBox.hgrow="ALWAYS">

                    <VBox spacing="4">
                        <Label style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"
                               text="Available Services" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13;"
                               text="Select a service to submit a request" />
                    </VBox>

                    <!-- ROW 1 -->
                    <HBox spacing="15">
                        <!-- Transcript -->
                        <VBox alignment="CENTER" spacing="10" prefWidth="190" prefHeight="140"
                              onMouseClicked="#handleTranscriptRequest"
                              style="
                                -fx-background-color: rgba(37,99,235,0.2);
                                -fx-background-radius: 20;
                                -fx-padding: 20;
                                -fx-border-color: rgba(37,99,235,0.4);
                                -fx-border-radius: 20;
                                -fx-cursor: hand;">
                            <Label style="-fx-font-size: 36;" text="📄" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"
                                   text="Transcript Request" />
                            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11;"
                                   text="Official academic transcript" />
                        </VBox>

                        <!-- ID Replacement -->
                        <VBox alignment="CENTER" spacing="10" prefWidth="190" prefHeight="140"
                              onMouseClicked="#handleIDRequest"
                              style="
                                -fx-background-color: rgba(124,58,237,0.2);
                                -fx-background-radius: 20;
                                -fx-padding: 20;
                                -fx-border-color: rgba(124,58,237,0.4);
                                -fx-border-radius: 20;
                                -fx-cursor: hand;">
                            <Label style="-fx-font-size: 36;" text="🪪" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"
                                   text="ID Replacement" />
                            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11;"
                                   text="Replace lost student ID" />
                        </VBox>
                    </HBox>

                    <!-- ROW 2 -->
                    <HBox spacing="15">
                        <!-- Enrollment Letter -->
                        <VBox alignment="CENTER" spacing="10" prefWidth="190" prefHeight="140"
                              onMouseClicked="#handleEnrollmentRequest"
                              style="
                                -fx-background-color: rgba(5,150,105,0.2);
                                -fx-background-radius: 20;
                                -fx-padding: 20;
                                -fx-border-color: rgba(5,150,105,0.4);
                                -fx-border-radius: 20;
                                -fx-cursor: hand;">
                            <Label style="-fx-font-size: 36;" text="✉" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"
                                   text="Enrollment Letter" />
                            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11;"
                                   text="Proof of enrollment letter" />
                        </VBox>

                        <!-- Course Withdrawal -->
                        <VBox alignment="CENTER" spacing="10" prefWidth="190" prefHeight="140"
                              onMouseClicked="#handleWithdrawalRequest"
                              style="
                                -fx-background-color: rgba(239,68,68,0.2);
                                -fx-background-radius: 20;
                                -fx-padding: 20;
                                -fx-border-color: rgba(239,68,68,0.4);
                                -fx-border-radius: 20;
                                -fx-cursor: hand;">
                            <Label style="-fx-font-size: 36;" text="📋" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"
                                   text="Course Withdrawal" />
                            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11;"
                                   text="Withdraw from a course" />
                        </VBox>
                    </HBox>

                    <!-- RECENT REQUESTS MINI TABLE -->
                    <VBox spacing="12" style="
                        -fx-background-color: rgba(255,255,255,0.05);
                        -fx-background-radius: 20;
                        -fx-padding: 20;
                        -fx-border-color: rgba(255,255,255,0.08);
                        -fx-border-radius: 20;">

                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"
                                   text="My Recent Requests" />
                            <Pane HBox.hgrow="ALWAYS"/>
                            <Button prefHeight="32" prefWidth="110"
                                    onAction="#goToStatus"
                                    style="
                                    -fx-background-color: #2563eb;
                                    -fx-text-fill: white;
                                    -fx-font-size: 12;
                                    -fx-font-weight: bold;
                                    -fx-background-radius: 10;
                                    -fx-cursor: hand;"
                                    text="View All →" />
                        </HBox>

                        <TableView fx:id="recentRequestsTable" prefHeight="200" style="
                            -fx-background-color: transparent;
                            -fx-control-inner-background: #1e293b;
                            -fx-table-cell-border-color: transparent;
                            -fx-font-size: 13;">
                            <columns>
                                <TableColumn fx:id="serviceColumn" prefWidth="220" text="Service" />
                                <TableColumn fx:id="dateColumn" prefWidth="160" text="Date" />
                                <TableColumn fx:id="statusColumn" prefWidth="130" text="Status" />
                            </columns>
                        </TableView>
                    </VBox>

                </VBox>

                <!-- RIGHT SIDEBAR -->
                <VBox prefWidth="280" spacing="20">

                    <!-- STUDENT PROFILE CARD -->
                    <VBox alignment="CENTER" spacing="12" style="
                        -fx-background-color: rgba(255,255,255,0.05);
                        -fx-background-radius: 20;
                        -fx-padding: 25;
                        -fx-border-color: rgba(255,255,255,0.08);
                        -fx-border-radius: 20;">
                        <Label style="-fx-font-size: 42;" text="🎓" />
                        <Label fx:id="studentNameLabel" style="
                            -fx-text-fill: white;
                            -fx-font-size: 18;
                            -fx-font-weight: bold;"
                               text="Student Name" />
                        <Label fx:id="studentIdLabel" style="-fx-text-fill: #94a3b8; -fx-font-size: 12;"
                               text="ID: 000000" />
                        <Label style="
                            -fx-background-color: rgba(37,99,235,0.3);
                            -fx-text-fill: #93c5fd;
                            -fx-font-size: 11;
                            -fx-font-weight: bold;
                            -fx-background-radius: 8;
                            -fx-padding: 4 10 4 10;"
                               text="STUDENT" />
                    </VBox>

                    <!-- QUICK STATS -->
                    <VBox spacing="14" style="
                        -fx-background-color: rgba(255,255,255,0.05);
                        -fx-background-radius: 20;
                        -fx-padding: 20;
                        -fx-border-color: rgba(255,255,255,0.08);
                        -fx-border-radius: 20;">
                        <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"
                               text="My Stats" />

                        <HBox alignment="CENTER_LEFT" spacing="14" style="
                            -fx-background-color: rgba(59,130,246,0.15);
                            -fx-background-radius: 14; -fx-padding: 12;">
                            <Label style="-fx-font-size: 20;" text="📄" />
                            <VBox>
                                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" text="Total Requests" />
                                <Label fx:id="totalLabel" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="0" />
                            </VBox>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="14" style="
                            -fx-background-color: rgba(245,158,11,0.15);
                            -fx-background-radius: 14; -fx-padding: 12;">
                            <Label style="-fx-font-size: 20;" text="⏳" />
                            <VBox>
                                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" text="Pending" />
                                <Label fx:id="pendingLabel" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="0" />
                            </VBox>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="14" style="
                            -fx-background-color: rgba(34,197,94,0.15);
                            -fx-background-radius: 14; -fx-padding: 12;">
                            <Label style="-fx-font-size: 20;" text="✔" />
                            <VBox>
                                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" text="Approved" />
                                <Label fx:id="approvedLabel" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="0" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- QUICK ACTIONS -->
                    <VBox spacing="12" style="
                        -fx-background-color: rgba(255,255,255,0.05);
                        -fx-background-radius: 20;
                        -fx-padding: 20;
                        -fx-border-color: rgba(255,255,255,0.08);
                        -fx-border-radius: 20;">
                        <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"
                               text="Quick Actions" />

                        <Button prefHeight="44" prefWidth="240"
                                onAction="#goToRequest"
                                style="
                                -fx-background-color: #2563eb;
                                -fx-text-fill: white;
                                -fx-font-size: 13;
                                -fx-font-weight: bold;
                                -fx-background-radius: 14;
                                -fx-cursor: hand;"
                                text="➕ New Request" />

                        <Button prefHeight="44" prefWidth="240"
                                onAction="#goToStatus"
                                style="
                                -fx-background-color: rgba(255,255,255,0.07);
                                -fx-text-fill: white;
                                -fx-font-size: 13;
                                -fx-font-weight: bold;
                                -fx-background-radius: 14;
                                -fx-border-color: #334155;
                                -fx-border-radius: 14;
                                -fx-cursor: hand;"
                                text="📋 Track Status" />

                        <Button prefHeight="44" prefWidth="240"
                                onAction="#handleLogout"
                                style="
                                -fx-background-color: rgba(239,68,68,0.15);
                                -fx-text-fill: #ef4444;
                                -fx-font-size: 13;
                                -fx-font-weight: bold;
                                -fx-background-radius: 14;
                                -fx-border-color: rgba(239,68,68,0.3);
                                -fx-border-radius: 14;
                                -fx-cursor: hand;"
                                text="🚪 Logout" />
                    </VBox>

                </VBox>
            </HBox>
        </ScrollPane>
    </center>

</BorderPane>